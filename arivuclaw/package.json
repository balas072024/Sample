{
  "name": "arivuclaw",
  "version": "1.0.0",
  "description": "ArivuClaw — Your intelligent AI assistant. Secure. Composable. Multi-platform. The wisdom way. 🦀",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "arivuclaw": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli/index.ts",
    "start": "node dist/cli/index.ts",
    "test": "jest --config jest.config.js",
    "test:unit": "jest --config jest.config.js tests/unit",
    "test:integration": "jest --config jest.config.js tests/integration",
    "lint": "eslint src/**/*.ts",
    "onboard": "ts-node src/cli/onboard.ts",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "keywords": [
    "ai",
    "assistant",
    "agent",
    "llm",
    "whatsapp",
    "telegram",
    "discord",
    "slack",
    "multi-platform",
    "skills",
    "composable",
    "secure",
    "rag",
    "memory"
  ],
  "author": "ArivuClaw Contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "openai": "^4.80.0",
    "ws": "^8.18.0",
    "express": "^4.21.0",
    "baileys": "^6.7.0",
    "grammy": "^1.30.0",
    "discord.js": "^14.16.0",
    "@slack/bolt": "^4.1.0",
    "hnswlib-node": "^3.0.0",
    "tiktoken": "^1.0.16",
    "yaml": "^2.6.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "inquirer": "^10.2.0",
    "dotenv": "^16.4.0",
    "zod": "^3.23.0",
    "winston": "^3.15.0",
    "uuid": "^10.0.0",
    "eventemitter3": "^5.0.1",
    "p-queue": "^8.0.1",
    "isolated-vm": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "@types/express": "^4.17.0",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "@types/jest": "^29.5.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "ts-node": "^10.9.0"
  }
}
