# Arivumaiyam AI Environment Variables
# Copy this file to .env and fill in your values

# ─── Execution Mode ────────────────────────────────────
# unrestricted = Full system access, no sandbox, no limits (for YOUR laptop)
# local-admin  = Elevated access with basic safety nets
# restricted   = Sandboxed, rate-limited (for shared/network deployments)
ARIVUCLAW_MODE=unrestricted

# ─── LLM Providers (use any or all) ────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here
GOOGLE_API_KEY=your-key-here
MINIMAX_API_KEY=your-minimax-key-here
DEEPSEEK_API_KEY=your-deepseek-key-here
GROQ_API_KEY=your-groq-key-here

# ─── Free Providers (no key needed) ────────────────────
# Ollama: Just install and run `ollama serve`
# Groq: Free tier available at console.groq.com
# DeepSeek: Generous free tier at platform.deepseek.com
# Neural Brain: Uses any backbone provider, no extra key

# ─── Default Provider & Model ──────────────────────────
ARIVUCLAW_PROVIDER=anthropic
ARIVUCLAW_MODEL=claude-sonnet-4-6
# Other options:
#   ARIVUCLAW_PROVIDER=ollama     ARIVUCLAW_MODEL=llama3.1
#   ARIVUCLAW_PROVIDER=minimax    ARIVUCLAW_MODEL=MiniMax-Text-01
#   ARIVUCLAW_PROVIDER=deepseek   ARIVUCLAW_MODEL=deepseek-chat
#   ARIVUCLAW_PROVIDER=groq       ARIVUCLAW_MODEL=llama-3.3-70b-versatile
#   ARIVUCLAW_PROVIDER=custom     (for Neural Brain mode)

# ─── Messaging Channels ────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
DISCORD_BOT_TOKEN=your-discord-bot-token
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token
SLACK_SIGNING_SECRET=your-signing-secret

# ─── Integrations ──────────────────────────────────────
GITHUB_TOKEN=ghp-your-github-token
JIRA_API_TOKEN=your-jira-token
JIRA_EMAIL=you@company.com
JIRA_BASE_URL=https://your-org.atlassian.net
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=your-ha-long-lived-token

# ─── Logging ───────────────────────────────────────────
ARIVUCLAW_LOG_LEVEL=info
